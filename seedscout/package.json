{
  "name": "seedscout",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @seedscout/web",
    "dev:api": "npm run dev -w @seedscout/api",
    "build": "npm run build -w @seedscout/web",
    "build:wasm": "packages/engine/native/build.sh",
    "test": "npm test -w @seedscout/engine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "npm run build && npm run deploy -w @seedscout/api"
  }
}
